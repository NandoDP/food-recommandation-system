# ==================== DATABASE ====================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/nutrisenegal_db

# ==================== API CONFIGURATION ====================
# Secret key for JWT tokens (generate a strong random key)
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-this-in-production

# Algorithm for JWT encoding
ALGORITHM=HS256

# Token expiration time (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Base URL (for external clients)
API_BASE_URL=http://localhost:8000

# ==================== TELEGRAM BOT ====================
# Get your token from @BotFather on Telegram
TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ==================== ENVIRONMENT ====================
# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (True/False)
DEBUG=True

# ==================== CORS ====================
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ==================== LOGGING ====================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (optional)
LOG_FILE=logs/app.log

# ==================== SPACY ====================
# spaCy model to use for NLP
SPACY_MODEL=fr_core_news_md

# ==================== NUTRITIONAL DATABASE ====================
# FAO data source (if using external API)
FAO_API_URL=https://api.fao.org/nutrition

# ==================== PERFORMANCE ====================
# Maximum number of recommendations to return
MAX_RECOMMENDATIONS=10

# Cache TTL in seconds (for frequently accessed data)
CACHE_TTL=3600

# ==================== NOTES ====================
# 1. Never commit the actual .env file to version control
# 2. Update values in your local .env file
# 3. Use strong passwords and secret keys in production
# 4. For production, use environment variables or secret management services