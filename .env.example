# ==================== DATABASE ====================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/nutrisenegal_db

# ==================== API CONFIGURATION ====================
# Secret key for JWT tokens (generate a strong random key)
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-this-in-production

# Algorithm for JWT encoding
ALGORITHM=HS256

# Token expiration time (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Base URL (for external clients)
API_BASE_URL=http://localhost:8000

# ==================== TELEGRAM BOT ====================
# Get your token from @BotFather on Telegram
TELEGRAM_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ==================== ENVIRONMENT ====================
# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (True/False)
DEBUG=True

# ==================== CORS ====================
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ==================== LOGGING ====================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (optional)
LOG_FILE=logs/app.log

# ==================== SPACY ====================
# spaCy model to use for NLP
SPACY_MODEL=fr_core_news_md

# ==================== NUTRITIONAL DATABASE ====================
# FAO data source (if using external API)
FAO_API_URL=https://api.fao.org/nutrition

# ==================== PERFORMANCE ====================
# Maximum number of recommendations to return
MAX_RECOMMENDATIONS=10

# Cache TTL in seconds (for frequently accessed data)
CACHE_TTL=3600

# ==================== N8N / ARCHITECTURE V2 ====================
# Cle de chiffrement des credentials n8n. A generer une seule fois :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# La perdre rend illisibles tous les credentials deja enregistres dans n8n.
N8N_ENCRYPTION_KEY=change-me-generate-a-random-32-bytes-key

# Cle partagee entre n8n et FastAPI (en-tete X-API-Key)
INTERNAL_API_KEY=change-me-generate-a-random-32-bytes-key

# URL HTTPS publique qui pointe vers n8n (obligatoire pour le webhook Telegram)
# Dev   : cloudflared tunnel --url http://localhost:5678
# Prod  : https://n8n.mondomaine.sn
PUBLIC_HTTPS_URL=
# Nombre de reverse-proxies devant n8n (1 avec cloudflared ou nginx)
N8N_PROXY_HOPS=1
# Hote de l'editeur n8n (laisser localhost en developpement)
N8N_HOST=localhost

# Second bot Telegram, utilise par n8n pendant la phase 1 pendant que l'ancien
# bot Python garde TELEGRAM_TOKEN en production
TELEGRAM_TOKEN_N8N=

# Mot de passe PostgreSQL utilise par docker-compose (services db, api, n8n)
DB_PASSWORD=changeme

# ==================== GEMINI ====================
# Cle API Google AI Studio : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Identifiants de modeles, lus dans les workflows via {{ $env.GEMINI_* }}.
# Jamais codes en dur dans les noeuds : les modeles TTS sont en preview et
# seront renommes (ARCHITECTURE_V2.md §4.4).
GEMINI_LLM_MODEL=gemini-3.8-flash
GEMINI_ASR_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ==================== NOTES ====================
# 1. Never commit the actual .env file to version control
# 2. Update values in your local .env file
# 3. Use strong passwords and secret keys in production
# 4. For production, use environment variables or secret management services