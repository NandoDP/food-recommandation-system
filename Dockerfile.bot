# NutriSénégal Telegram Bot - Dockerfile
FROM python:3.12-slim

# Metadata
LABEL maintainer="maodo2000diop@gmail.com"
LABEL description="NutriSénégal Telegram Bot"
LABEL version="1.0.0"

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy bot code (le bot parle à l'API en HTTP, il n'embarque pas api/)
COPY telegram_bot/ ./telegram_bot/

# Create non-root user
RUN useradd -m -u 1000 nutrisenegal && \
    chown -R nutrisenegal:nutrisenegal /app
USER nutrisenegal

# Les imports sont absolus (telegram_bot.*) : la racine doit être sur le PYTHONPATH
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Run bot (polling, pas de port exposé)
CMD ["python", "-m", "telegram_bot.bot"]
