# Image n8n personnalisée pour NutriSénégal (ARCHITECTURE_V2.md §8).
#
# Ajout par rapport à l'image officielle : ffmpeg, nécessaire dès la phase 2
# (voix) pour convertir le PCM 16 bits / 24 kHz / mono sorti par le TTS Gemini
# en OGG/Opus, seul format accepté par `sendVoice` de l'API Telegram (§4.3) :
#   ffmpeg -f s16le -ar 24000 -ac 1 -i in.pcm -c:a libopus out.ogg
#
# Depuis la v2, n8nio/n8n est une « Docker Hardened Image » : Alpine sans
# gestionnaire de paquets, donc pas de `apk add`. On copie à la place un
# binaire ffmpeg statique, autosuffisant (aucune bibliothèque partagée à
# installer dans l'image durcie).
#
# Les deux versions sont épinglées volontairement : les workflows exportés
# dans n8n/workflows/ dépendent de la version des nœuds. Monter de version
# est une décision, pas un effet de bord du prochain `docker compose build`.
FROM mwader/static-ffmpeg:8.1.2 AS ffmpeg

FROM n8nio/n8n:2.39.5
# COPY s'exécute en root même si l'image cible tourne en `node`
COPY --from=ffmpeg /ffmpeg /usr/local/bin/ffmpeg
