    {
      "id": "01a127f5-107b-4516-af39-c67955be5aff",
      "name": "Normaliser l’update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Aplatit l'update Telegram en une enveloppe stable, consommee par tous les\n// workflows en aval (WF2, WF3, WF6, WF7). Le format Telegram ne doit pas\n// fuiter plus loin que ce noeud.\nconst sortie = [];\n\nfor (const item of $input.all()) {\n  const u = item.json;\n  const msg = u.message ?? u.edited_message ?? null;\n  const cb = u.callback_query ?? null;\n  const from = cb?.from ?? msg?.from ?? {};\n  const chat = cb?.message?.chat ?? msg?.chat ?? {};\n\n  let kind = 'other';\n  let text = null;\n  let file_id = null;\n  let callback_data = null;\n\n  if (cb) {\n    kind = 'callback';\n    callback_data = cb.data ?? null;\n  } else if (msg?.voice) {\n    kind = 'voice';\n    file_id = msg.voice.file_id;\n  } else if (msg?.audio) {\n    kind = 'voice';\n    file_id = msg.audio.file_id;\n  } else if (msg?.text) {\n    kind = 'text';\n    text = msg.text;\n  }\n\n  sortie.push({\n    json: {\n      update_id: u.update_id,\n      kind,\n      // Dans ce projet l'identifiant Telegram est aussi users.id\n      telegram_id: String(from.id ?? ''),\n      chat_id: chat.id ?? from.id ?? null,\n      message_id: cb?.message?.message_id ?? msg?.message_id ?? null,\n      callback_query_id: cb?.id ?? null,\n      text,\n      file_id,\n      duration: msg?.voice?.duration ?? msg?.audio?.duration ?? null,\n      callback_data,\n      // Prefixes attendus : action_, dish_, alt_, disease_, allergen_, meal_\n      callback_prefix: callback_data ? String(callback_data).split('_')[0] + '_' : null,\n      telegram_first_name: from.first_name ?? null,\n      telegram_last_name: from.last_name ?? null,\n      telegram_language: from.language_code ?? null,\n      received_at: new Date().toISOString(),\n    },\n  });\n}\n\nreturn sortie;\n"
      }
    },
    {
      "id": "00f539e4-880f-401c-9af3-e6a4443f983e",
      "name": "Marquer l’update",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        -20,
        300
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH nouveau AS (\n  INSERT INTO bot_processed_updates (update_id)\n  VALUES ($1)\n  ON CONFLICT (update_id) DO NOTHING\n  RETURNING update_id\n)\nSELECT EXISTS (SELECT 1 FROM nouveau) AS is_new;",
        "options": {
          "queryReplacement": "={{ [ $json.update_id ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": null,
          "name": "Postgres NutriSénégal"
        }
      },
      "notes": "Telegram rejoue les updates non acquittes : sans ce garde-fou une analyse (et sa facturation LLM) serait relancee."
    },
    {
      "id": "22697b17-ec1d-45ef-bb77-473f6c7208ad",
      "name": "Recoller l’enveloppe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Le noeud Postgres remplace l'item par le resultat de la requete :\n// on recolle l'enveloppe pour garder un objet plat en aval.\nconst enveloppe = $('Normaliser l’update').first().json;\nconst resultat = $input.first().json;\n\nreturn [{ json: { ...enveloppe, is_new: resultat.is_new === true } }];\n"
      }
    },
