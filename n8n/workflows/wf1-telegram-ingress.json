    {
      "id": "ee82e358-5c7e-4fd1-be70-8ad538dae03f",
      "name": "Charger le contexte",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        640,
        140
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Garantit l'existence de la session et memorise le chat_id,\n-- puis renvoie profil + session en une seule ligne.\nWITH s AS (\n  INSERT INTO bot_sessions (telegram_id, chat_id)\n  VALUES ($1, $2)\n  ON CONFLICT (telegram_id) DO UPDATE\n    SET chat_id = EXCLUDED.chat_id, updated_at = CURRENT_TIMESTAMP\n  RETURNING telegram_id, state, draft, history, last_lang\n)\nSELECT\n  u.id           AS user_id,\n  u.first_name   AS user_first_name,\n  u.language     AS user_language,\n  hp.id          AS health_profile_id,\n  s.state        AS session_state,\n  s.draft        AS session_draft,\n  s.history      AS session_history,\n  s.last_lang    AS session_last_lang\nFROM (SELECT $1::text AS telegram_id) k\nLEFT JOIN users u ON u.id = k.telegram_id\nLEFT JOIN LATERAL (\n  SELECT id FROM health_profiles WHERE user_id = u.id LIMIT 1\n) hp ON true\nLEFT JOIN s ON s.telegram_id = k.telegram_id;",
        "options": {
          "queryReplacement": "={{ [ $json.telegram_id, $json.chat_id ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": null,
          "name": "Postgres NutriSénégal"
        }
      },
      "notes": "Renvoie toujours une ligne : NULL sur les colonnes users/health_profiles si l'utilisateur est inconnu."
    },
    {
      "id": "eaa41b5c-44bb-4856-8d37-bec9142d4c04",
      "name": "Fusionner le contexte",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        860,
        140
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Enveloppe + profil + session dans un seul objet plat.\nconst enveloppe = $('Normaliser l’update').first().json;\nconst contexte = $input.first().json;\n\nconst langue = contexte.user_language\n  || contexte.session_last_lang\n  || (['fr', 'wo', 'en'].includes(enveloppe.telegram_language) ? enveloppe.telegram_language : 'fr');\n\nreturn [{\n  json: {\n    ...enveloppe,\n    ...contexte,\n    is_known_user: Boolean(contexte.user_id),\n    session_state: contexte.session_state ?? 'IDLE',\n    language: langue,\n  },\n}];\n"
      }
    },
